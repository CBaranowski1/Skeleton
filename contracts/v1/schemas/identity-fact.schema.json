{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/identity-fact.schema.json",
  "title": "Skeleton Identity Fact v1",
  "description": "A closed bitemporal alias, provider, venue, name, or lifecycle fact beneath an immutable stable identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fact_id",
    "stable_identity_id",
    "fact_kind",
    "fact_state",
    "provider",
    "value",
    "effective_from",
    "effective_to",
    "available_at"
  ],
  "properties": {
    "schema_version": {
      "const": "skeleton.identity-fact.v1"
    },
    "fact_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "stable_identity_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "fact_kind": {
      "enum": [
        "alias",
        "contract",
        "corporate_action",
        "fork",
        "lifecycle",
        "name",
        "provider_identifier",
        "roll",
        "team",
        "venue"
      ]
    },
    "fact_state": {
      "enum": [
        "resolved",
        "superseded"
      ]
    },
    "provider": {
      "oneOf": [
        {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "value": {
      "$ref": "#/$defs/canonicalText"
    },
    "effective_from": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "effective_to": {
      "oneOf": [
        {
          "$ref": "#/$defs/normalizedTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "available_at": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "supersedes_fact_id": {
      "oneOf": [
        {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "canonicalText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "normalizedTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/canonical-event.schema.json",
  "title": "Skeleton Canonical Event v1",
  "description": "An immutable canonical event with explicit bitemporal, identity, sequence, correction, rights, parser, raw, and payload evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "source_time",
    "received_at",
    "ingested_at",
    "available_at",
    "effective_at",
    "stable_identity_id",
    "stable_identity_version",
    "venue",
    "market",
    "sequence_state",
    "sequence",
    "correction_of",
    "quality",
    "mode",
    "rights_record_id",
    "rights_decision_id",
    "parser_version",
    "parser_code_sha256",
    "raw_sha256",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "skeleton.canonical-event.v1"
    },
    "event_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "source_time": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "received_at": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "ingested_at": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "available_at": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "effective_at": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "stable_identity_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "stable_identity_version": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/safeInteger"
    },
    "venue": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
    },
    "market": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
    },
    "sequence_state": {
      "enum": ["resolved", "unresolved"]
    },
    "sequence": {
      "oneOf": [
        {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/safeInteger"
        },
        {
          "type": "null"
        }
      ]
    },
    "correction_of": {
      "oneOf": [
        {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "quality": {
      "enum": [
        "backfilled",
        "contaminated",
        "corrected",
        "legacy",
        "provider_reported",
        "synthetic",
        "unknown"
      ]
    },
    "mode": {
      "enum": [
        "evaluation",
        "fixture",
        "historical",
        "paper",
        "simulation"
      ]
    },
    "rights_record_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "rights_decision_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "parser_version": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
    },
    "parser_code_sha256": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "raw_sha256": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "payload_sha256": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sequence_state": {"const": "resolved"}
        },
        "required": ["sequence_state"]
      },
      "then": {
        "properties": {
          "sequence": {
            "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/safeInteger"
          }
        }
      },
      "else": {
        "properties": {
          "sequence": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "normalizedTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    }
  }
}

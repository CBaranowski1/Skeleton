{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/rejection.schema.json",
  "title": "Skeleton Typed Rejection v1",
  "description": "A bounded machine-readable rejection that cannot echo secrets, credentials, executable content, or input payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rejection_id",
    "subject_class",
    "subject_id",
    "reason_code",
    "validation_stage",
    "occurred_at",
    "retryable"
  ],
  "properties": {
    "schema_version": {
      "const": "skeleton.rejection.v1"
    },
    "rejection_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "subject_class": {
      "enum": [
        "advisory_proposal",
        "authority_grant",
        "authority_result",
        "constitution",
        "experience_envelope",
        "lifecycle_event",
        "unknown",
        "work_object"
      ]
    },
    "subject_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "reason_code": {
      "enum": [
        "authorization_denied",
        "cross_class",
        "expired",
        "framing_ambiguous",
        "hash_mismatch",
        "malformed_signature_wire",
        "replayed",
        "schema_invalid",
        "signature_invalid",
        "signer_epoch_mismatch",
        "signer_key_mismatch",
        "signer_revoked",
        "state_conflict",
        "unknown_signature_protocol"
      ]
    },
    "validation_stage": {
      "enum": [
        "authorization",
        "framing",
        "freshness",
        "raw_bytes",
        "replay",
        "schema",
        "signature",
        "state"
      ]
    },
    "occurred_at": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "$defs": {
    "normalizedTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    }
  }
}

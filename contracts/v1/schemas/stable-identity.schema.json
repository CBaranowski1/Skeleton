{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/stable-identity.schema.json",
  "title": "Skeleton Stable Identity v1",
  "description": "An immutable genesis-bound primary identity that never derives authority from an alias, provider identifier, venue, or current roster.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stable_identity_id",
    "genesis_content_sha256",
    "genesis_time",
    "identity_kind",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": "skeleton.stable-identity.v1"
    },
    "stable_identity_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "genesis_content_sha256": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "genesis_time": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "identity_kind": {
      "enum": [
        "asset",
        "contract",
        "instrument",
        "organization",
        "team",
        "venue"
      ]
    },
    "version": {
      "allOf": [
        {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/safeInteger"
        },
        {
          "minimum": 1
        }
      ]
    }
  },
  "$defs": {
    "normalizedTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    }
  }
}

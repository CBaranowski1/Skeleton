{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/authority-result.schema.json",
  "title": "Skeleton D-25 Authority Result Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["signature_protocol_version", "object_class", "signature_domain", "signer_key_id", "signer_set_epoch", "body", "signature"],
  "properties": {
    "signature_protocol_version": {"const": 1},
    "object_class": {"const": "authority_result"},
    "signature_domain": {"const": "skeleton.authority-result.v1"},
    "signer_key_id": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/ed25519KeyId"},
    "signer_set_epoch": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/canonicalUint64"},
    "body": {"$ref": "#/$defs/body"},
    "signature": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/ed25519Signature"}
  },
  "$defs": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "authority_domain", "command_id", "disposition", "state_before_sha256", "state_after_sha256", "event_id", "completed_at"],
      "properties": {
        "schema_version": {"const": "skeleton.authority-result.body.v1"},
        "authority_domain": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"},
        "command_id": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
        "disposition": {"enum": ["committed", "rejected", "no_change"]},
        "state_before_sha256": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
        "state_after_sha256": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
        "event_id": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
        "completed_at": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/advisory-proposal.schema.json",
  "title": "Skeleton Advisory Proposal Envelope v1",
  "description": "The D-25 advisory class: signed, expiring, provenance-bound, and structurally incapable of carrying authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signature_protocol_version",
    "object_class",
    "signature_domain",
    "signer_key_id",
    "signer_set_epoch",
    "body",
    "signature"
  ],
  "properties": {
    "signature_protocol_version": {
      "const": 1
    },
    "object_class": {
      "const": "advisory_proposal"
    },
    "signature_domain": {
      "const": "skeleton.advisory-proposal.v1"
    },
    "signer_key_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/ed25519KeyId"
    },
    "signer_set_epoch": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/canonicalUint64"
    },
    "body": {
      "$ref": "#/$defs/advisoryProposalBody"
    },
    "signature": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/ed25519Signature"
    }
  },
  "$defs": {
    "normalizedTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "advisoryProposalBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "proposal_id",
        "project_id",
        "work_id",
        "experience_id",
        "created_at",
        "expires_at",
        "nonce",
        "policy_sha256",
        "observations",
        "recommendation",
        "eligibility"
      ],
      "properties": {
        "schema_version": {
          "const": "skeleton.advisory-proposal.body.v1"
        },
        "proposal_id": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        },
        "project_id": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
        },
        "work_id": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        },
        "experience_id": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        },
        "created_at": {
          "$ref": "#/$defs/normalizedTimestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/normalizedTimestamp"
        },
        "nonce": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/proposalObservation"
          }
        },
        "recommendation": {
          "$ref": "#/$defs/recommendation"
        },
        "eligibility": {
          "$ref": "#/$defs/eligibility"
        }
      }
    },
    "proposalObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "evidence_sha256"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidence_sha256": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "expected_outcome"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "expected_outcome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "requires_fresh_authorization"
      ],
      "properties": {
        "scope": {
          "const": "owner_project_only"
        },
        "requires_fresh_authorization": {
          "const": true
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/model-memory-payload.schema.json",
  "title": "Skeleton Immutable Model Memory Payload v1",
  "description": "Closed model artifact, feature, dataset, calibration, evaluation, parent, code, and descriptive promotion history record.",
  "type": "object",
  "additionalProperties": false,
  "x-skeleton-sorted-inventories": [
    "calibration_ids",
    "dataset_manifest_ids",
    "evaluation_ids",
    "parent_model_ids"
  ],
  "x-skeleton-lineage-constraints": {
    "parent_inventory": "parent_model_ids",
    "parent_excludes": "model_id",
    "promotion_stage_transition_must_change": true
  },
  "required": [
    "schema_version",
    "model_id",
    "feature_manifest_id",
    "feature_manifest_sha256",
    "model_artifact",
    "calibration_ids",
    "dataset_manifest_ids",
    "evaluation_ids",
    "parent_model_ids",
    "code_id",
    "code_sha256",
    "promotion_history"
  ],
  "properties": {
    "schema_version": {"const": "skeleton.model-memory-payload.v1"},
    "model_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "feature_manifest_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "feature_manifest_sha256": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "model_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "artifact_id", "artifact_sha256"],
      "properties": {
        "artifact_kind": {"enum": ["weights", "prompt_profile"]},
        "artifact_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
        "artifact_sha256": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"}
      }
    },
    "calibration_ids": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/nonemptyHashInventory"},
    "dataset_manifest_ids": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/nonemptyHashInventory"},
    "evaluation_ids": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/nonemptyHashInventory"},
    "parent_model_ids": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/nonemptyHashInventory"},
    "code_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "code_sha256": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "promotion_history": {
      "type": "array",
      "uniqueItems": true,
      "x-skeleton-ordering": "event_id_lexicographic",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "from_stage", "to_stage", "decision_id", "result", "recorded_at"],
        "properties": {
          "event_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
          "from_stage": {"enum": ["candidate", "challenger", "shadow", "paper"]},
          "to_stage": {"enum": ["candidate", "challenger", "shadow", "paper"]},
          "decision_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
          "result": {"enum": ["accepted", "rejected", "revoked", "superseded"]},
          "recorded_at": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/utcTimestamp"}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/material-authorization.schema.json",
  "title": "Skeleton D-25 Material Authorization Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["signature_protocol_version", "object_class", "signature_domain", "signer_key_id", "signer_set_epoch", "body", "signature"],
  "properties": {
    "signature_protocol_version": {"const": 1},
    "object_class": {"const": "authority_grant"},
    "signature_domain": {"const": "skeleton.authority-grant.v1"},
    "signer_key_id": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/ed25519KeyId"},
    "signer_set_epoch": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/canonicalUint64"},
    "body": {"$ref": "#/$defs/body"},
    "signature": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/ed25519Signature"}
  },
  "$defs": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "authorization_id", "subject", "action", "scope", "issued_at", "expires_at", "reauthentication_proof_sha256", "audit_id", "reversibility"],
      "properties": {
        "schema_version": {"const": "skeleton.material-authorization.body.v1"},
        "authorization_id": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
        "subject": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"},
        "action": {"enum": ["activate", "deactivate", "pause", "resume", "promote", "override", "transmit", "authorize", "revoke"]},
        "scope": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"},
        "issued_at": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"},
        "expires_at": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"},
        "reauthentication_proof_sha256": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
        "audit_id": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
        "reversibility": {"enum": ["reversible", "compensating_action_only", "irreversible"]}
      }
    }
  }
}

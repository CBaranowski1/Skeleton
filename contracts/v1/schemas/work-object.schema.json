{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/work-object.schema.json",
  "title": "Skeleton Work Object v1",
  "description": "A strict domain-neutral, content-addressed unit of owner-authorized work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "project_id",
    "work_kind",
    "objective",
    "input_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "skeleton.work-object.v1"
    },
    "work_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "project_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
    },
    "work_kind": {
      "enum": [
        "evaluate",
        "observe",
        "plan",
        "review",
        "transform"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "input_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/evidenceReference"
      }
    }
  },
  "$defs": {
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "sha256"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
        },
        "sha256": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        }
      }
    }
  }
}

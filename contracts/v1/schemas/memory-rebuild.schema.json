{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/memory-rebuild.schema.json",
  "title": "Skeleton Exact Champion Memory Rebuild v1",
  "description": "A complete isolated rebuild binding exact inventories and roots with only verified success or one deterministic first divergence.",
  "type": "object",
  "additionalProperties": false,
  "x-skeleton-sorted-inventories": [
    "source_inventory.source_id",
    "migration_inventory.migration_id",
    "index_inventory.index_id",
    "query_inventory.query_id",
    "ledger_inventory.ledger_id",
    "metric_inventory.metric_name"
  ],
  "x-skeleton-exact-counters": [
    ["source_count", "source_inventory"],
    ["migration_count", "migration_inventory"],
    ["index_count", "index_inventory"],
    ["query_count", "query_inventory"],
    ["ledger_count", "ledger_inventory"],
    ["metric_count", "metric_inventory"]
  ],
  "required": [
    "schema_version",
    "rebuild_run_id",
    "rebuild_run_sha256",
    "rebuild_manifest_id",
    "rebuild_manifest_sha256",
    "source_inventory",
    "migration_inventory",
    "index_inventory",
    "query_inventory",
    "ledger_inventory",
    "metric_inventory",
    "source_count",
    "migration_count",
    "index_count",
    "query_count",
    "ledger_count",
    "metric_count",
    "exact_roots",
    "execution_evidence",
    "terminal_status"
  ],
  "properties": {
    "schema_version": {"const": "skeleton.memory-rebuild.v1"},
    "rebuild_run_id": {"$ref": "#/$defs/sha256"},
    "rebuild_run_sha256": {"$ref": "#/$defs/sha256"},
    "rebuild_manifest_id": {"$ref": "#/$defs/sha256"},
    "rebuild_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-skeleton-ordering": "source_id_lexicographic",
      "items": {"$ref": "#/$defs/sourceBinding"}
    },
    "migration_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-skeleton-ordering": "migration_id_lexicographic",
      "items": {"$ref": "#/$defs/migrationBinding"}
    },
    "index_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-skeleton-ordering": "index_id_lexicographic",
      "items": {"$ref": "#/$defs/indexBinding"}
    },
    "query_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-skeleton-ordering": "query_id_lexicographic",
      "items": {"$ref": "#/$defs/queryBinding"}
    },
    "ledger_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-skeleton-ordering": "ledger_id_lexicographic",
      "items": {"$ref": "#/$defs/ledgerBinding"}
    },
    "metric_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-skeleton-ordering": "metric_name_lexicographic",
      "items": {"$ref": "#/$defs/metricBinding"}
    },
    "source_count": {"$ref": "#/$defs/positiveInteger"},
    "migration_count": {"$ref": "#/$defs/positiveInteger"},
    "index_count": {"$ref": "#/$defs/positiveInteger"},
    "query_count": {"$ref": "#/$defs/positiveInteger"},
    "ledger_count": {"$ref": "#/$defs/positiveInteger"},
    "metric_count": {"$ref": "#/$defs/positiveInteger"},
    "exact_roots": {"$ref": "#/$defs/exactRoots"},
    "execution_evidence": {"$ref": "#/$defs/executionEvidence"},
    "terminal_status": {"enum": ["verified", "failed"]},
    "verified_at": {"$ref": "#/$defs/timestamp"},
    "first_divergence": {"$ref": "#/$defs/firstDivergence"}
  },
  "oneOf": [
    {
      "required": ["verified_at"],
      "properties": {
        "terminal_status": {"const": "verified"},
        "execution_evidence": {
          "properties": {
            "missing_reference_count": {"const": 0},
            "skipped_reference_count": {"const": 0},
            "unavailable_tool_count": {"const": 0},
            "network_accessed": {"const": false},
            "ambient_cache_used": {"const": false}
          }
        },
        "metric_inventory": {
          "items": {
            "properties": {"within_tolerance": {"const": true}}
          }
        }
      },
      "not": {"required": ["first_divergence"]}
    },
    {
      "required": ["first_divergence"],
      "properties": {"terminal_status": {"const": "failed"}},
      "not": {"required": ["verified_at"]}
    }
  ],
  "$defs": {
    "sha256": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "identifier": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/identifier"},
    "timestamp": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/utcTimestamp"},
    "safeInteger": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/safeNonnegativeInteger"},
    "positiveInteger": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/positiveInteger"},
    "sourceKind": {
      "enum": [
        "memory",
        "evidence",
        "rights",
        "lineage",
        "procedure",
        "model",
        "audit",
        "correction",
        "contradiction",
        "quarantine",
        "retrieval"
      ]
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_id", "source_sha256"],
      "properties": {
        "source_kind": {"$ref": "#/$defs/sourceKind"},
        "source_id": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "migrationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "migration_id", "migration_sha256"],
      "properties": {
        "ordinal": {"$ref": "#/$defs/safeInteger"},
        "migration_id": {"type": "string", "pattern": "^[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "migration_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "indexBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index_id", "index_sha256"],
      "properties": {
        "index_id": {"$ref": "#/$defs/identifier"},
        "index_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "queryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "query_sha256"],
      "properties": {
        "query_id": {"$ref": "#/$defs/sha256"},
        "query_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "ledgerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_id", "ledger_sha256"],
      "properties": {
        "ledger_id": {"$ref": "#/$defs/sha256"},
        "ledger_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "metricName": {
      "enum": [
        "bytes_read",
        "bytes_returned",
        "candidate_count",
        "max_latency_us",
        "p50_latency_us",
        "p95_latency_us",
        "record_count"
      ]
    },
    "exactDecimalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "value"],
      "properties": {
        "representation": {"const": "exact_decimal"},
        "value": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"}
      }
    },
    "rationalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "numerator", "denominator"],
      "properties": {
        "representation": {"const": "rational"},
        "numerator": {"$ref": "#/$defs/safeInteger"},
        "denominator": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "numericValue": {
      "oneOf": [
        {"$ref": "#/$defs/exactDecimalValue"},
        {"$ref": "#/$defs/rationalValue"}
      ]
    },
    "metricBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_name",
        "expected",
        "observed",
        "absolute_difference",
        "tolerance",
        "within_tolerance"
      ],
      "properties": {
        "metric_name": {"$ref": "#/$defs/metricName"},
        "expected": {"$ref": "#/$defs/numericValue"},
        "observed": {"$ref": "#/$defs/numericValue"},
        "absolute_difference": {"$ref": "#/$defs/numericValue"},
        "tolerance": {"$ref": "#/$defs/numericValue"},
        "within_tolerance": {"type": "boolean"}
      }
    },
    "exactRoots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_root_sha256",
        "migration_root_sha256",
        "contract_registry_root_sha256",
        "evidence_root_sha256",
        "rights_root_sha256",
        "lineage_root_sha256",
        "canonical_memory_root_sha256",
        "correction_root_sha256",
        "contradiction_root_sha256",
        "quarantine_root_sha256",
        "candidate_snapshot_root_sha256",
        "index_root_sha256",
        "query_root_sha256",
        "retrieval_ledger_root_sha256",
        "result_root_sha256",
        "metric_inventory_root_sha256"
      ],
      "properties": {
        "schema_root_sha256": {"$ref": "#/$defs/sha256"},
        "migration_root_sha256": {"$ref": "#/$defs/sha256"},
        "contract_registry_root_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_root_sha256": {"$ref": "#/$defs/sha256"},
        "rights_root_sha256": {"$ref": "#/$defs/sha256"},
        "lineage_root_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_memory_root_sha256": {"$ref": "#/$defs/sha256"},
        "correction_root_sha256": {"$ref": "#/$defs/sha256"},
        "contradiction_root_sha256": {"$ref": "#/$defs/sha256"},
        "quarantine_root_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_snapshot_root_sha256": {"$ref": "#/$defs/sha256"},
        "index_root_sha256": {"$ref": "#/$defs/sha256"},
        "query_root_sha256": {"$ref": "#/$defs/sha256"},
        "retrieval_ledger_root_sha256": {"$ref": "#/$defs/sha256"},
        "result_root_sha256": {"$ref": "#/$defs/sha256"},
        "metric_inventory_root_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "executionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_reference_count",
        "executed_reference_count",
        "missing_reference_count",
        "skipped_reference_count",
        "unavailable_tool_count",
        "network_accessed",
        "ambient_cache_used"
      ],
      "properties": {
        "declared_reference_count": {"$ref": "#/$defs/positiveInteger"},
        "executed_reference_count": {"$ref": "#/$defs/safeInteger"},
        "missing_reference_count": {"$ref": "#/$defs/safeInteger"},
        "skipped_reference_count": {"$ref": "#/$defs/safeInteger"},
        "unavailable_tool_count": {"$ref": "#/$defs/safeInteger"},
        "network_accessed": {"type": "boolean"},
        "ambient_cache_used": {"type": "boolean"}
      }
    },
    "identityDivergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["divergence_stage", "subject_id", "expected_sha256", "observed_sha256"],
      "properties": {
        "divergence_stage": {
          "enum": [
            "schema_root",
            "migration_root",
            "contract_registry_root",
            "evidence_root",
            "rights_root",
            "lineage_root",
            "canonical_memory_root",
            "correction_root",
            "contradiction_root",
            "quarantine_root",
            "candidate_snapshot_root",
            "index_root",
            "query_root",
            "retrieval_ledger_root",
            "result_root",
            "metric_inventory_root",
            "source_inventory",
            "migration_inventory",
            "index_inventory",
            "query_inventory",
            "ledger_inventory",
            "metric_inventory"
          ]
        },
        "subject_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/noneOrSha256"},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "observed_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "metricDivergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "divergence_stage",
        "metric_name",
        "expected",
        "observed",
        "absolute_difference",
        "tolerance"
      ],
      "properties": {
        "divergence_stage": {"const": "metric_value"},
        "metric_name": {"$ref": "#/$defs/metricName"},
        "expected": {"$ref": "#/$defs/numericValue"},
        "observed": {"$ref": "#/$defs/numericValue"},
        "absolute_difference": {"$ref": "#/$defs/numericValue"},
        "tolerance": {"$ref": "#/$defs/numericValue"}
      }
    },
    "prerequisiteDivergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["divergence_stage", "subject_id", "expected_code", "observed_code"],
      "properties": {
        "divergence_stage": {
          "enum": [
            "missing_reference",
            "skipped_reference",
            "unavailable_tool",
            "network_access",
            "ambient_cache"
          ]
        },
        "subject_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/noneOrSha256"},
        "expected_code": {"$ref": "#/$defs/identifier"},
        "observed_code": {"$ref": "#/$defs/identifier"}
      }
    },
    "firstDivergence": {
      "oneOf": [
        {"$ref": "#/$defs/identityDivergence"},
        {"$ref": "#/$defs/metricDivergence"},
        {"$ref": "#/$defs/prerequisiteDivergence"}
      ]
    }
  }
}

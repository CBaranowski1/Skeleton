{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/rights-record.schema.json",
  "title": "Skeleton Rights Record v1",
  "description": "A complete deny-by-default rights record with eight independently evaluated use boundaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rights_record_id",
    "legal_terms_id",
    "status",
    "effective_from",
    "effective_to",
    "boundaries",
    "processing_boundary",
    "destination"
  ],
  "properties": {
    "schema_version": {
      "const": "skeleton.rights-record.v1"
    },
    "rights_record_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "legal_terms_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "status": {
      "enum": [
        "active",
        "expired",
        "revoked",
        "superseded",
        "terminated",
        "unknown"
      ]
    },
    "effective_from": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "effective_to": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "boundaries": {
      "$ref": "#/$defs/useBoundaries"
    },
    "processing_boundary": {
      "$ref": "#/$defs/processingBoundary"
    },
    "destination": {
      "$ref": "#/$defs/destination"
    }
  },
  "$defs": {
    "normalizedTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "processingBoundary": {
      "enum": [
        "approved_local_boundary",
        "external_model",
        "local_only"
      ]
    },
    "destination": {
      "enum": [
        "approved_local_model",
        "backup_repository",
        "export_recipient",
        "external_model",
        "local_owner_system"
      ]
    },
    "useBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingest",
        "retrieval",
        "prompt",
        "training",
        "evaluation",
        "export",
        "backup",
        "activation"
      ],
      "properties": {
        "ingest": {"type": "boolean"},
        "retrieval": {"type": "boolean"},
        "prompt": {"type": "boolean"},
        "training": {"type": "boolean"},
        "evaluation": {"type": "boolean"},
        "export": {"type": "boolean"},
        "backup": {"type": "boolean"},
        "activation": {"type": "boolean"}
      }
    }
  }
}

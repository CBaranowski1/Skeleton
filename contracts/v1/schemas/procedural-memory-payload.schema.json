{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/procedural-memory-payload.schema.json",
  "title": "Skeleton Versioned Procedural Memory Payload v1",
  "description": "Closed identity-and-hash-only procedure record with no prompt, transcript, callback, grant, or authority-bearing surface.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "procedure_id",
    "procedure_version",
    "procedure_version_id",
    "template_identity_id",
    "template_sha256",
    "routing_rule_identity_id",
    "routing_rule_sha256",
    "policy_identity_id",
    "policy_sha256",
    "input_schema_id",
    "input_schema_sha256",
    "output_schema_id",
    "output_schema_sha256",
    "tool_manifest_id",
    "tool_manifest_sha256",
    "permission_profile_id",
    "permission_profile_sha256"
  ],
  "properties": {
    "schema_version": {"const": "skeleton.procedural-memory-payload.v1"},
    "procedure_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "procedure_version": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/schemaVersion"},
    "procedure_version_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "template_identity_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "template_sha256": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "routing_rule_identity_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "routing_rule_sha256": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "policy_identity_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "policy_sha256": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "input_schema_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "input_schema_sha256": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "output_schema_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "output_schema_sha256": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "tool_manifest_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "tool_manifest_sha256": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "permission_profile_id": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"},
    "permission_profile_sha256": {"$ref": "https://schemas.skeleton.local/v1/memory-primitives.schema.json#/$defs/sha256"}
  }
}

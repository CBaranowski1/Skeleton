{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/memory-residue.schema.json",
  "title": "Skeleton Privacy-Sharded Residue Sketch Snapshot v1",
  "description": "One fixed-geometry integer sketch snapshot per metabolism cycle: five closed statistic families, per-shard bounded saturating counters, and sketch keys declared as domain-framed hashes of closed category tuples; no member can carry a raw identifier, per-item row, invertible encoding, or evicted-content digest.",
  "x-skeleton-append-only": true,
  "x-skeleton-authority-free": true,
  "x-skeleton-identity-domain": "SKELETON_PHASE12_RESIDUE_SNAPSHOT_V1",
  "x-skeleton-non-reconstructable": true,
  "$defs": {
    "statisticFamily": {
      "enum": [
        "encounter",
        "co_occurrence",
        "retrieval_regret",
        "novelty",
        "failure"
      ]
    },
    "saturatingCounter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "counterRow": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/saturatingCounter"}
    },
    "shardSketch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shard_index", "key_domain", "rows"],
      "properties": {
        "shard_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "key_domain": {
          "type": "string",
          "pattern": "^SKELETON_PHASE12_RESIDUE_SHARD_[0-3]_V1$"
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/counterRow"}
        }
      }
    },
    "familySketch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "shards"],
      "properties": {
        "family": {"$ref": "#/$defs/statisticFamily"},
        "shards": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": false,
          "x-skeleton-ordering": "shard_index_ascending",
          "items": {"$ref": "#/$defs/shardSketch"}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "residue_snapshot_id",
    "cycle_ordinal",
    "cycle_input_root",
    "fence_id",
    "generation",
    "attempt_ordinal",
    "geometry",
    "key_derivation",
    "families"
  ],
  "properties": {
    "schema_version": {"const": "skeleton.memory-residue.v1"},
    "record_type": {"const": "residue_snapshot"},
    "residue_snapshot_id": {"$ref": "https://schemas.skeleton.local/v1/agent-primitives.schema.json#/$defs/sha256"},
    "cycle_ordinal": {"$ref": "https://schemas.skeleton.local/v1/agent-primitives.schema.json#/$defs/safeNonnegativeInteger"},
    "cycle_input_root": {"$ref": "https://schemas.skeleton.local/v1/agent-primitives.schema.json#/$defs/sha256"},
    "fence_id": {"$ref": "https://schemas.skeleton.local/v1/agent-primitives.schema.json#/$defs/sha256"},
    "generation": {"$ref": "https://schemas.skeleton.local/v1/agent-primitives.schema.json#/$defs/safeNonnegativeInteger"},
    "attempt_ordinal": {"$ref": "https://schemas.skeleton.local/v1/agent-primitives.schema.json#/$defs/positiveInteger"},
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry_version", "shard_count", "depth", "width"],
      "properties": {
        "geometry_version": {"const": "skeleton.memory-residue-geometry.v1"},
        "shard_count": {"const": 4},
        "depth": {"const": 2},
        "width": {"const": 16}
      }
    },
    "key_derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derivation", "category_tuple"],
      "properties": {
        "derivation": {"const": "domain_framed_category_tuple_hash"},
        "category_tuple": {
          "const": ["memory_kind", "scope_class", "outcome_class", "regret_class"]
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "x-skeleton-ordering": "statistic_family_canonical_order",
      "x-skeleton-unique-fields": [["family"]],
      "items": {"$ref": "#/$defs/familySketch"}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/market-conversion.schema.json",
  "title": "Skeleton Market Conversion Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "conversion_id", "base_currency", "quote_currency", "rate", "source_id", "source_time", "effective_at", "available_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "skeleton.market-conversion.v1"},
    "conversion_id": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
    "base_currency": {"enum": ["USD", "EUR"]},
    "quote_currency": {"enum": ["USD", "EUR"]},
    "rate": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/canonicalExactDecimal"},
    "source_id": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
    "source_time": {"$ref": "https://schemas.skeleton.local/v1/market-primitives.schema.json#/$defs/utcTimestamp"},
    "effective_at": {"$ref": "https://schemas.skeleton.local/v1/market-primitives.schema.json#/$defs/utcTimestamp"},
    "available_at": {"$ref": "https://schemas.skeleton.local/v1/market-primitives.schema.json#/$defs/utcTimestamp"},
    "expires_at": {"$ref": "https://schemas.skeleton.local/v1/market-primitives.schema.json#/$defs/utcTimestamp"}
  }
}

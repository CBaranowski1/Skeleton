{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/primitives.schema.json",
  "title": "Skeleton Contract Primitives v1",
  "description": "Strict I-JSON and RFC 8785/JCS-compatible primitive profiles.",
  "$defs": {
    "finiteBinary64": {
      "type": "number",
      "minimum": -1.7976931348623157e+308,
      "maximum": 1.7976931348623157e+308
    },
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "canonicalInteger": {
      "type": "string",
      "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)$"
    },
    "canonicalExactDecimal": {
      "type": "string",
      "pattern": "^(?!-0(?:\\.0*)?$)-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$"
    },
    "canonicalUint64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|18446744[0-6][0-9]{11}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ed25519PublicKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ed25519KeyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ed25519Signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^skeleton\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.v[1-9][0-9]*$"
    }
  }
}

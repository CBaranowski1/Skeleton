{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/lobe-package.schema.json",
  "title": "Skeleton Lobe Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "package_version",
    "package_sha256",
    "contracts",
    "senses",
    "tools",
    "capabilities",
    "permissions",
    "memory_namespaces",
    "evaluators",
    "workflows",
    "migrations",
    "uninstall"
  ],
  "properties": {
    "schema_version": {
      "const": "skeleton.lobe-package.v1"
    },
    "package_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
    },
    "package_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "package_sha256": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contractExtension"
      }
    },
    "senses": {
      "$ref": "#/$defs/identifierSet"
    },
    "tools": {
      "$ref": "#/$defs/identifierSet"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "evaluate_evidence",
          "invoke_declared_tools",
          "manage_namespaced_memory",
          "manage_owner_projects",
          "propose_actions",
          "run_declared_workflows"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystem_read_namespaces",
        "filesystem_write_namespaces",
        "outbound_network_allowed",
        "credential_access_allowed"
      ],
      "properties": {
        "filesystem_read_namespaces": {
          "$ref": "#/$defs/identifierSet"
        },
        "filesystem_write_namespaces": {
          "$ref": "#/$defs/identifierSet"
        },
        "outbound_network_allowed": {
          "type": "boolean"
        },
        "credential_access_allowed": {
          "const": false
        }
      }
    },
    "memory_namespaces": {
      "$ref": "#/$defs/identifierSet"
    },
    "evaluators": {
      "$ref": "#/$defs/identifierSet"
    },
    "workflows": {
      "$ref": "#/$defs/identifierSet"
    },
    "migrations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/migration"
      }
    },
    "uninstall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removable",
        "core_mutation_required",
        "state_disposition",
        "rollback_supported"
      ],
      "properties": {
        "removable": {
          "const": true
        },
        "core_mutation_required": {
          "const": false
        },
        "state_disposition": {
          "enum": [
            "archive_namespaced_state",
            "erase_namespaced_state",
            "retain_namespaced_state"
          ]
        },
        "rollback_supported": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "identifierSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
      }
    },
    "contractExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_sha256",
        "extension_mode"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "schema_sha256": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        },
        "extension_mode": {
          "const": "additive"
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_version",
        "to_version",
        "procedure_sha256",
        "rollback_sha256"
      ],
      "properties": {
        "from_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "to_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "procedure_sha256": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        },
        "rollback_sha256": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/rights-use-decision.schema.json",
  "title": "Skeleton Rights Use Decision v1",
  "description": "A redacted permit or deny decision binding exact legal, rights, request, boundary, and destination identities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "request_id",
    "legal_terms_id",
    "rights_record_id",
    "boundary",
    "processing_boundary",
    "destination",
    "decision",
    "reason_code",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "skeleton.rights-use-decision.v1"
    },
    "decision_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "request_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "legal_terms_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "rights_record_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "boundary": {
      "$ref": "#/$defs/useBoundary"
    },
    "processing_boundary": {
      "$ref": "#/$defs/processingBoundary"
    },
    "destination": {
      "$ref": "#/$defs/destination"
    },
    "decision": {
      "enum": ["deny", "permit"]
    },
    "reason_code": {
      "enum": [
        "acquisition_not_authorized",
        "decision_ambiguous",
        "external_transmission_not_authorized",
        "rights_decision_boundary_mismatch",
        "rights_expired",
        "rights_incompatible",
        "rights_record_incomplete",
        "rights_record_missing",
        "rights_revoked",
        "rights_unknown",
        "terms_and_rights_match",
        "unresolved_counsel_question"
      ]
    },
    "decided_at": {
      "$ref": "#/$defs/normalizedTimestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {"const": "permit"}
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "reason_code": {"const": "terms_and_rights_match"}
        }
      },
      "else": {
        "properties": {
          "reason_code": {
            "not": {"const": "terms_and_rights_match"}
          }
        }
      }
    }
  ],
  "$defs": {
    "normalizedTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "useBoundary": {
      "enum": [
        "activation",
        "backup",
        "evaluation",
        "export",
        "ingest",
        "prompt",
        "retrieval",
        "training"
      ]
    },
    "processingBoundary": {
      "enum": [
        "approved_local_boundary",
        "external_model",
        "local_only"
      ]
    },
    "destination": {
      "enum": [
        "approved_local_model",
        "backup_repository",
        "export_recipient",
        "external_model",
        "local_owner_system"
      ]
    }
  }
}

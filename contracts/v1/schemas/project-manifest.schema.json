{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/project-manifest.schema.json",
  "title": "Skeleton Project Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "constitution_sha256",
    "lobe_set_sha256",
    "lobe_packages",
    "environment_identity",
    "goals",
    "dependencies",
    "state_namespace",
    "requested_capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "skeleton.project-manifest.v1"
    },
    "project_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
    },
    "constitution_sha256": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "lobe_set_sha256": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "lobe_packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/lobeBinding"
      }
    },
    "environment_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "isolation_class"
      ],
      "properties": {
        "environment_id": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
        },
        "isolation_class": {
          "enum": [
            "development",
            "evaluation",
            "operational"
          ]
        }
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
      }
    },
    "state_namespace": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
    },
    "requested_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "evaluate_evidence",
          "invoke_declared_tools",
          "manage_namespaced_memory",
          "manage_owner_projects",
          "propose_actions",
          "run_declared_workflows"
        ]
      }
    }
  },
  "$defs": {
    "lobeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "package_sha256"
      ],
      "properties": {
        "package_id": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
        },
        "package_sha256": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        }
      }
    }
  }
}

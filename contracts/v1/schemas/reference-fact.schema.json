{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/reference-fact.schema.json",
  "title": "Skeleton Point-in-Time Reference Fact v1",
  "description": "A versioned bitemporal reference fact with explicit applicability and fail-closed unresolved state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fact_id",
    "stable_identity_id",
    "fact_kind",
    "fact_state",
    "applicability",
    "value",
    "effective_from",
    "effective_to",
    "available_at"
  ],
  "properties": {
    "schema_version": {
      "const": "skeleton.reference-fact.v1"
    },
    "fact_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "stable_identity_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "fact_kind": {
      "enum": [
        "calendar",
        "corporate_action",
        "currency",
        "early_close",
        "fork",
        "holiday",
        "lifecycle",
        "lot_size",
        "multiplier",
        "resolution_rule",
        "roll",
        "session",
        "settlement",
        "tick_size",
        "timezone",
        "unit",
        "void_rule"
      ]
    },
    "fact_state": {
      "enum": [
        "resolved",
        "superseded",
        "unresolved"
      ]
    },
    "applicability": {
      "enum": [
        "applicable",
        "not_applicable",
        "unresolved"
      ]
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/canonicalText"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_code": {
      "enum": [
        "not_applicable_by_definition",
        "not_applicable_for_identity",
        "unresolved_calendar",
        "unresolved_clock",
        "unresolved_currency",
        "unresolved_identity_mapping",
        "unresolved_lifecycle",
        "unresolved_sequence",
        "unresolved_settlement",
        "unresolved_timezone",
        "unresolved_unit"
      ]
    },
    "effective_from": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "effective_to": {
      "oneOf": [
        {
          "$ref": "#/$defs/normalizedTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "available_at": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "supersedes_fact_id": {
      "oneOf": [
        {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "applicability": {
            "const": "applicable"
          }
        },
        "required": [
          "applicability"
        ]
      },
      "then": {
        "properties": {
          "fact_state": {
            "const": "resolved"
          },
          "value": {
            "$ref": "#/$defs/canonicalText"
          }
        },
        "not": {
          "required": [
            "reason_code"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "const": "not_applicable"
          }
        },
        "required": [
          "applicability"
        ]
      },
      "then": {
        "properties": {
          "fact_state": {
            "const": "resolved"
          },
          "value": {
            "type": "null"
          },
          "reason_code": {
            "enum": [
              "not_applicable_by_definition",
              "not_applicable_for_identity"
            ]
          }
        },
        "required": [
          "reason_code"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "const": "unresolved"
          }
        },
        "required": [
          "applicability"
        ]
      },
      "then": {
        "properties": {
          "fact_state": {
            "const": "unresolved"
          },
          "value": {
            "type": "null"
          },
          "reason_code": {
            "pattern": "^unresolved_[a-z_]+$"
          }
        },
        "required": [
          "reason_code"
        ]
      }
    }
  ],
  "$defs": {
    "canonicalText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\ud800-\\udfff]+$"
    },
    "normalizedTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    }
  }
}

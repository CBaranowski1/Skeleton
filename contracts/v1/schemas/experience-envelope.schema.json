{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/experience-envelope.schema.json",
  "title": "Skeleton Experience Envelope v1",
  "description": "A strict content-addressed observation of one domain-neutral work object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experience_id",
    "project_id",
    "work_id",
    "observed_at",
    "outcome",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "skeleton.experience-envelope.v1"
    },
    "experience_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "project_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
    },
    "work_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "observed_at": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "outcome": {
      "enum": [
        "abstained",
        "completed",
        "failed",
        "partial"
      ]
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "$defs": {
    "normalizedTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "summary",
        "evidence_sha256"
      ],
      "properties": {
        "observation_id": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidence_sha256": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        }
      }
    }
  }
}

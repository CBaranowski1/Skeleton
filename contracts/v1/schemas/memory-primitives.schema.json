{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/memory-primitives.schema.json",
  "title": "Skeleton Hierarchical Memory Primitives v1",
  "description": "Closed provider-neutral primitives for attributable hierarchical memory.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
    },
    "schemaVersion": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/schemaVersion"
    },
    "exactDecimal": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/canonicalExactDecimal"
    },
    "safeNonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]*[1-9])?Z$"
    },
    "hashInventory": {
      "type": "array",
      "uniqueItems": true,
      "x-skeleton-ordering": "lexicographic",
      "items": {"$ref": "#/$defs/sha256"}
    },
    "nonemptyHashInventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "x-skeleton-ordering": "lexicographic",
      "items": {"$ref": "#/$defs/sha256"}
    },
    "memoryKind": {
      "enum": ["working", "episodic", "semantic", "procedural", "model", "audit"]
    },
    "qualityClass": {
      "enum": ["verified", "corrected", "provider_reported", "backfilled", "synthetic", "simulated", "contaminated", "legacy", "unknown"]
    },
    "provenanceClass": {
      "enum": ["verified_real", "derived_real", "owner_asserted", "seeded_test", "fixture", "simulated", "synthetic", "unknown"]
    },
    "quarantineState": {
      "enum": ["clean", "legacy", "synthetic", "stale", "revoked_rights", "contaminated", "unverifiable"]
    },
    "operatingMode": {
      "enum": ["evaluation", "fixture", "historical", "offline", "paper", "research", "simulation"]
    },
    "modelStage": {
      "enum": ["none", "candidate", "challenger", "shadow", "paper"]
    },
    "noneOrSha256": {
      "oneOf": [
        {"const": "none"},
        {"$ref": "#/$defs/sha256"}
      ]
    },
    "noneOrTimestamp": {
      "oneOf": [
        {"const": "none"},
        {"$ref": "#/$defs/utcTimestamp"}
      ]
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope_kind"],
          "properties": {"scope_kind": {"const": "none"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope_kind", "scope_id"],
          "properties": {
            "scope_kind": {"const": "domain"},
            "scope_id": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope_kind", "scope_id"],
          "properties": {
            "scope_kind": {"const": "market"},
            "scope_id": {"$ref": "#/$defs/identifier"}
          }
        }
      ]
    }
  }
}

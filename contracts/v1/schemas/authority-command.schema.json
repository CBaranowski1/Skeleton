{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/authority-command.schema.json",
  "title": "Skeleton Authority Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority_domain", "command_id", "expected_state_sha256", "lifecycle_effect", "authorization_id", "requested_at"],
  "properties": {
    "schema_version": {"const": "skeleton.authority-command.v1"},
    "authority_domain": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"},
    "command_id": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
    "expected_state_sha256": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
    "lifecycle_effect": {"enum": ["activate", "deactivate", "pause", "resume", "revoke"]},
    "authorization_id": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
    "requested_at": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"}
  }
}

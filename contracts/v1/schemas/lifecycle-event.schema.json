{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/lifecycle-event.schema.json",
  "title": "Skeleton Lifecycle Event v1",
  "description": "A strict content-addressed transition for a domain-neutral subject.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "subject",
    "prior_state",
    "new_state",
    "cause",
    "authorization",
    "occurred_at",
    "event_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "skeleton.lifecycle-event.v1"
    },
    "event_id": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "prior_state": {
      "$ref": "#/$defs/lifecycleState"
    },
    "new_state": {
      "$ref": "#/$defs/lifecycleState"
    },
    "cause": {
      "$ref": "#/$defs/cause"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "occurred_at": {
      "$ref": "#/$defs/normalizedTimestamp"
    },
    "event_sha256": {
      "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "normalizedTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"
    },
    "lifecycleState": {
      "enum": [
        "absent",
        "active",
        "completed",
        "failed",
        "pending",
        "rejected",
        "removed",
        "suspended"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_type",
        "subject_id"
      ],
      "properties": {
        "subject_type": {
          "enum": [
            "advisory_proposal",
            "experience_envelope",
            "lobe_package",
            "project",
            "work_object"
          ]
        },
        "subject_id": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        }
      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "evidence_sha256"
      ],
      "properties": {
        "code": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"
        },
        "evidence_sha256": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "evidence_sha256"
      ],
      "properties": {
        "mode": {
          "enum": [
            "owner_authorized",
            "policy_authorized",
            "system_recovery"
          ]
        },
        "evidence_sha256": {
          "$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skeleton.local/v1/kernel-status.schema.json",
  "title": "Skeleton Truthful Kernel Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_identity", "bundle_sha256", "semantic_state_hash", "journal_state_hash", "authority_snapshot_hash", "incomplete_journal_disposition", "authority_process_health", "cognition_process_health", "lobe_count", "capabilities", "observed_at"],
  "properties": {
    "schema_version": {"const": "skeleton.kernel-status.v1"},
    "product_identity": {"const": "skeleton.private-single-owner"},
    "bundle_sha256": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
    "semantic_state_hash": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
    "journal_state_hash": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
    "authority_snapshot_hash": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/sha256"},
    "incomplete_journal_disposition": {"enum": ["idle", "RECEIVED", "EFFECT_COMMITTED", "RESULT_COMMITTED"]},
    "authority_process_health": {"enum": ["available", "degraded", "unavailable"]},
    "cognition_process_health": {"enum": ["available", "degraded", "unavailable"]},
    "lobe_count": {"type": "integer", "minimum": 0, "maximum": 1024},
    "capabilities": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "https://schemas.skeleton.local/v1/primitives.schema.json#/$defs/identifier"}},
    "observed_at": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?Z$"}
  }
}

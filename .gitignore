.azure/
.config/gcloud/
.gnupg/
.kube/
.ssh/
/private/
/secrets/
/.owner/
/owner-private/
**/credentials.local.*
**/secrets.local.*
**/tokens.local.*

# Owner-local configuration and public-export staging
config/local.*
config/private.*
config/owner-local.*
/.public-export/
/public-export/
/public-mirror/
/.planning/tmp/

# This file prevents new local or sensitive artifacts from entering Git.
# It does not remove files that are already tracked or erase them from history.

# Secrets, credentials, signing material, and local identity
.env
.env.*
!.env.example
*.key
*.pem
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
*.ovpn
*.mobileprovision
id_rsa*
